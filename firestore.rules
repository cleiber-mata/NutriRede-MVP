rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de validação estática
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Consulta aos registros de governança no banco de dados
    function hasAdminDoc(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }

    function getAdminDoc(uid) {
      return get(/databases/$(database)/documents/admins/$(uid)).data;
    }

    function hasSystemConfig() {
      return exists(/databases/$(database)/documents/system/config);
    }

    function getSystemConfig() {
      return get(/databases/$(database)/documents/system/config).data;
    }

    // O usuário é o PROPRIETÁRIO (OWNER) apenas se houver consistência estrita:
    function isSystemOwner() {
      return isSignedIn() &&
        hasSystemConfig() &&
        getSystemConfig().ownerUid == request.auth.uid &&
        hasAdminDoc(request.auth.uid) &&
        getAdminDoc(request.auth.uid).role == 'OWNER' &&
        getAdminDoc(request.auth.uid).uid == request.auth.uid;
    }

    // O usuário é ADMINISTRADOR se for o OWNER ou tiver role in ['ADMIN', 'OWNER'] em /admins/{uid}
    function isAdmin() {
      return isSignedIn() && (
        isSystemOwner() ||
        (hasAdminDoc(request.auth.uid) && getAdminDoc(request.auth.uid).role in ['ADMIN', 'OWNER'])
      );
    }

    // Verificação de aprovação de perfil específico do usuário
    function hasApprovedProfile(profileType) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid + '_' + profileType)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid + '_' + profileType)).data.status == 'APROVADO';
    }

    // Bloqueio padrão universal
    match /{document=**} {
      allow read, write: if false;
    }

    // Endpoint de teste de conectividade
    match /test/connection {
      allow read: if true;
    }

    // Coleção de Governança do Sistema (/system/config)
    match /system/{docId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if isSystemOwner() &&
        docId == 'config' &&
        incoming().keys().hasAll(['ownerUid', 'ownerEmail', 'initializedAt', 'systemVersion']);
      allow delete: if false;
    }

    // Coleção de Administradores (/admins/{adminId})
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSystemOwner() &&
        isValidId(adminId) &&
        incoming().uid == adminId &&
        incoming().role in ['ADMIN', 'OWNER'];
      allow update: if (
        isSystemOwner() &&
        incoming().uid == existing().uid &&
        incoming().role in ['ADMIN', 'OWNER']
      ) || (
        isSignedIn() &&
        request.auth.uid == adminId &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().email == request.auth.token.email &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
      );
      allow delete: if isSystemOwner() && adminId != request.auth.uid;
    }

    // Coleção: Logs de Auditoria e Segurança (/audit_logs/{logId})
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().action in [
          'CHANGE_EMAIL_REQUESTED',
          'EMAIL_SYNCED',
          'PROFILE_EDITED',
          'PROFILE_DEACTIVATED',
          'PROFILE_REACTIVATION_REQUESTED'
        ] &&
        incoming().keys().hasAll(['id', 'userId', 'action', 'timestamp', 'status']);
      allow update, delete: if false; // Imutabilidade de trilha de auditoria
    }

    // Coleção: Usuários (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().name is string &&
        incoming().name.size() >= 2 &&
        incoming().name.size() <= 120 &&
        incoming().email is string &&
        incoming().email.size() <= 120 &&
        incoming().accountStatus in ['ACTIVE', 'BLOCKED'] &&
        incoming().keys().hasAll(['uid', 'name', 'email', 'createdAt', 'accountStatus']);

      allow update: if (
        isOwner(userId) &&
        incoming().uid == existing().uid &&
        (
          // Edição de dados cadastrais normais (sem alterar e-mail)
          (incoming().email == existing().email &&
           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'notes', 'updatedAt'])) ||
          // Sincronização segura de e-mail verificado no Firebase Auth
          (incoming().email == request.auth.token.email &&
           incoming().diff(existing()).affectedKeys().hasOnly(['email', 'previousEmail', 'emailChangedAt', 'updatedAt', 'name', 'phone', 'address', 'notes']))
        )
      ) || isAdmin();

      allow delete: if isSystemOwner();
    }

    // Coleção: Perfis de Atuação (/profiles/{profileId})
    match /profiles/{profileId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'PENDENTE' &&
        incoming().profileType in ['DONOR', 'RECEIVER', 'TRANSPORTER'] &&
        incoming().userName is string &&
        incoming().userName.size() <= 120 &&
        incoming().userEmail is string &&
        incoming().userEmail.size() <= 120 &&
        incoming().keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'profileType', 'status', 'requestedAt']);

      allow update: if (
        // Usuário atualizando dados permitidos do seu próprio perfil
        isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().profileType == existing().profileType &&
        (
          // Edição de contato e disponibilidade operacional de transporte
          (incoming().diff(existing()).affectedKeys().hasOnly([
             'userName', 'userPhone', 'address', 'operationalNotes',
             'transporterAvailability', 'availabilityUpdatedAt',
             'lastEditedAt', 'lastEditedBy'
           ]) && incoming().status == existing().status) ||
          // Sincronização segura de e-mail verificado no Firebase Auth
          (incoming().userEmail == request.auth.token.email &&
           incoming().diff(existing()).affectedKeys().hasOnly(['userEmail', 'previousEmail', 'emailChangedAt', 'lastEditedAt', 'lastEditedBy']) &&
           incoming().status == existing().status) ||
          // Desativação voluntária segura
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deactivatedAt', 'deactivatedBy', 'deactivationReason', 'lastEditedAt']) &&
           incoming().status == 'DESATIVADO') ||
          // Pedido de reativação (vai para PENDENTE)
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reactivatedAt', 'lastEditedAt', 'decisionNotes']) &&
           incoming().status == 'PENDENTE')
        )
      ) || isAdmin();

      allow delete: if isSystemOwner();
    }

    // ==========================================
    // CICLO 2 & 3: LOTES DE ALIMENTOS (/food_batches/{batchId})
    // ==========================================
    match /food_batches/{batchId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // RF04: Apenas DOADOR APROVADO pode cadastrar lote
      allow create: if isSignedIn() &&
        hasApprovedProfile('DONOR') &&
        incoming().donorId == request.auth.uid &&
        incoming().status == 'DISPONIVEL' &&
        incoming().quantity is number &&
        incoming().quantity > 0 &&
        incoming().unit in ['kg', 'g', 'litros', 'unidades'] &&
        incoming().fitForConsumption == true &&
        incoming().foodName is string &&
        incoming().foodName.size() >= 3 &&
        incoming().foodName.size() <= 150 &&
        incoming().keys().hasAll([
          'id', 'donorId', 'donorName', 'foodName', 'category',
          'quantity', 'unit', 'expirationDate', 'storageCondition',
          'pickupAddress', 'pickupWindowStart', 'pickupWindowEnd',
          'fitForConsumption', 'status', 'createdAt'
        ]);

      // Atualização de lotes com rastreabilidade completa do ciclo de vida:
      allow update: if isSignedIn() && (
        // Doador cancelando o lote
        (existing().donorId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().status == 'CANCELADO') ||

        // Entidade receptora aprovada reservando o lote disponível (bloqueia autorreserva)
        (hasApprovedProfile('RECEIVER') &&
         existing().status == 'DISPONIVEL' &&
         incoming().status == 'RESERVADO' &&
         incoming().reservedBy == request.auth.uid &&
         existing().donorId != request.auth.uid &&
         incoming().reservedBy != existing().donorId) ||

        // Entidade receptora liberando lote após cancelamento de sua reserva
        (hasApprovedProfile('RECEIVER') &&
         existing().reservedBy == request.auth.uid &&
         (incoming().status == 'DISPONIVEL' || incoming().status == 'EXPIRADO')) ||

        // Transportador aprovado aceitando coleta: vincula activePickupId e dados do transportador
        (hasApprovedProfile('TRANSPORTER') &&
         existing().status == 'RESERVADO' &&
         incoming().transporterId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['activePickupId', 'transporterId', 'transporterName', 'updatedAt'])) ||

        // Transportador aprovado confirmando retirada: transição para EM_TRANSPORTE
        (hasApprovedProfile('TRANSPORTER') &&
         existing().transporterId == request.auth.uid &&
         incoming().status == 'EM_TRANSPORTE' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'pickedUpAt', 'updatedAt'])) ||

        // Entidade receptora titular confirmando recebimento: transição final para CONCLUIDO (RN08)
        (hasApprovedProfile('RECEIVER') &&
         existing().reservedBy == request.auth.uid &&
         incoming().status == 'CONCLUIDO' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])) ||

        // Administrador gerenciando status de reserva
        isAdmin()
      );

      allow delete: if isSystemOwner();
    }

    // ==========================================
    // CICLO 2 & 3: RESERVAS DE LOTES (/reservations/{reservationId})
    // ==========================================
    match /reservations/{reservationId} {
      allow get: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        resource.data.transporterId == request.auth.uid ||
        hasApprovedProfile('TRANSPORTER') ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        hasApprovedProfile('TRANSPORTER') ||
        isAdmin() ||
        resource.data.receiverId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        resource.data.transporterId == request.auth.uid
      );

      // RF06: Apenas ENTIDADE RECEPTORA APROVADA pode solicitar reserva
      // Proibição estrita de autorreserva (donorId != request.auth.uid)
      allow create: if isSignedIn() &&
        hasApprovedProfile('RECEIVER') &&
        incoming().receiverId == request.auth.uid &&
        incoming().status == 'PENDENTE_APROVACAO' &&
        incoming().donorId != request.auth.uid &&
        incoming().receiverId != incoming().donorId &&
        exists(/databases/$(database)/documents/food_batches/$(incoming().batchId)) &&
        get(/databases/$(database)/documents/food_batches/$(incoming().batchId)).data.donorId != request.auth.uid &&
        incoming().keys().hasAll([
          'id', 'batchId', 'foodName', 'batchQuantity', 'batchUnit',
          'donorId', 'donorName', 'receiverId', 'receiverName',
          'receiverEmail', 'status', 'requestedAt'
        ]);

      // Atualização de reservas em conformidade com o ciclo operacional:
      allow update: if isSignedIn() && (
        // RF07: Cancelamento pela própria entidade receptora solicitante
        (existing().receiverId == request.auth.uid &&
         incoming().status == 'CANCELADA' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'canceledAt', 'cancelReason'])) ||

        // RF10: Vinculação de coleta aceita por transportador aprovado
        (hasApprovedProfile('TRANSPORTER') &&
         existing().status == 'APROVADA' &&
         incoming().transporterId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['activePickupId', 'transporterId', 'transporterName', 'updatedAt'])) ||

        // RF11: Registro de retirada pelo transportador titular
        (hasApprovedProfile('TRANSPORTER') &&
         existing().transporterId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['pickedUpAt'])) ||

        // RF12: Registro de recebimento concluído pela entidade receptora titular (RN08)
        (existing().receiverId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['completedAt', 'deliveryId', 'updatedAt'])) ||

        // RF08: Homologação ou rejeição exclusivamente pelo Administrador ou Proprietário
        (isAdmin() &&
         incoming().status in ['APROVADA', 'REJEITADA'] &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'decisionNotes']))
      );

      allow delete: if isSystemOwner();
    }

    // ==========================================
    // CICLO 3: COLETAS (/pickups/{pickupId})
    // ==========================================
    match /pickups/{pickupId} {
      allow get: if isSignedIn() && (
        resource.data.transporterUserId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        hasApprovedProfile('TRANSPORTER') ||
        isAdmin() ||
        resource.data.transporterUserId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        resource.data.donorId == request.auth.uid
      );

      // RF10: Aceite exclusivo por Transportador Aprovado
      allow create: if isSignedIn() &&
        hasApprovedProfile('TRANSPORTER') &&
        incoming().transporterUserId == request.auth.uid &&
        incoming().status == 'ACEITA' &&
        incoming().keys().hasAll([
          'id', 'reservationId', 'batchId', 'foodName', 'batchQuantity',
          'batchUnit', 'donorId', 'donorName', 'pickupAddress',
          'pickupWindowStart', 'pickupWindowEnd', 'receiverId',
          'receiverName', 'transporterUserId', 'transporterName',
          'transporterEmail', 'status', 'acceptedAt'
        ]);

      // RF11: Registro de Retirada pelo Transportador Titular
      allow update: if isSignedIn() && (
        (existing().transporterUserId == request.auth.uid &&
         incoming().status == 'RETIRADA' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'pickedUpAt'])) ||
        isAdmin()
      );

      allow delete: if isSystemOwner();
    }

    // ==========================================
    // CICLO 3: ENTREGAS (/deliveries/{deliveryId})
    // ==========================================
    match /deliveries/{deliveryId} {
      allow get: if isSignedIn() && (
        resource.data.receiverUserId == request.auth.uid ||
        resource.data.transporterUserId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        hasApprovedProfile('RECEIVER') ||
        isAdmin() ||
        resource.data.receiverUserId == request.auth.uid ||
        resource.data.transporterUserId == request.auth.uid ||
        resource.data.donorId == request.auth.uid
      );

      // RF12 & RN08: Confirmação de Entrega pela Entidade Receptora Vinculada
      allow create: if isSignedIn() &&
        hasApprovedProfile('RECEIVER') &&
        incoming().receiverUserId == request.auth.uid &&
        incoming().keys().hasAll([
          'id', 'pickupId', 'reservationId', 'batchId', 'foodName',
          'batchQuantity', 'batchUnit', 'donorId', 'donorName',
          'receiverUserId', 'receiverName', 'transporterUserId',
          'transporterName', 'confirmedAt'
        ]);

      allow update: if isAdmin();
      allow delete: if isSystemOwner();
    }

    // ==========================================
    // CICLO 3: OCORRÊNCIAS OPERACIONAIS (/occurrences/{occurrenceId})
    // ==========================================
    match /occurrences/{occurrenceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // RF14: Registro de ocorrência por participante autenticado
      allow create: if isSignedIn() &&
        incoming().authorUserId == request.auth.uid &&
        incoming().stage in ['COLETA', 'TRANSPORTE', 'ENTREGA', 'GERAL'] &&
        incoming().description is string &&
        incoming().description.size() >= 5 &&
        incoming().keys().hasAll([
          'id', 'operationId', 'batchId', 'authorUserId', 'authorName',
          'authorProfile', 'stage', 'type', 'description', 'createdAt'
        ]);

      allow update: if isAdmin();
      allow delete: if isSystemOwner();
    }

    // ==========================================
    // CICLO 3: HISTÓRICO DE OPERAÇÕES (/operation_history/{eventId})
    // ==========================================
    match /operation_history/{eventId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // RF15: Registro imutável de eventos operacionais
      allow create: if isSignedIn() &&
        incoming().actorUserId == request.auth.uid &&
        incoming().keys().hasAll([
          'id', 'objectType', 'objectId', 'event', 'actorUserId',
          'activeProfile', 'timestamp'
        ]);

      // Trilha de auditoria imutável
      allow update, delete: if false;
    }
  }
}
