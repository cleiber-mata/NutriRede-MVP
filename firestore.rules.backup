// Backup of firestore.rules before administrative security hardening
// Timestamp: 2026-11-02T08:15:26-08:00
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "cleiber.mata@gmail.com"
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/connection {
      allow read: if true;
    }

    // Collection: users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().name is string &&
        incoming().name.size() >= 2 &&
        incoming().name.size() <= 120 &&
        incoming().email is string &&
        incoming().email.size() <= 120 &&
        incoming().accountStatus in ['ACTIVE', 'BLOCKED'] &&
        incoming().keys().hasAll(['uid', 'name', 'email', 'createdAt', 'accountStatus']) &&
        incoming().keys().hasOnly(['uid', 'name', 'email', 'phone', 'createdAt', 'accountStatus']);

      allow update: if (
        isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone'])
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // Collection: profiles
    match /profiles/{profileId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Ordinary users can only request profiles in 'PENDENTE' status for their own user ID
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'PENDENTE' &&
        incoming().profileType in ['DONOR', 'RECEIVER', 'TRANSPORTER'] &&
        incoming().userName is string &&
        incoming().userName.size() <= 120 &&
        incoming().userEmail is string &&
        incoming().userEmail.size() <= 120 &&
        incoming().keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'profileType', 'status', 'requestedAt']) &&
        incoming().keys().hasOnly(['id', 'userId', 'userName', 'userEmail', 'userPhone', 'profileType', 'status', 'requestedAt', 'decidedAt', 'decidedBy', 'decisionNotes']);

      // Only administrators can approve or reject profiles and update decision notes
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // Collection: admins
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
