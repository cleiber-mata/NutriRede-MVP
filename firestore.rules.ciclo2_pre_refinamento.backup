// Backup das regras do Firestore antes dos refinamentos do Ciclo 2 (03/11/2026)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasAdminDoc(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }

    function getAdminDoc(uid) {
      return get(/databases/$(database)/documents/admins/$(uid)).data;
    }

    function hasSystemConfig() {
      return exists(/databases/$(database)/documents/system/config);
    }

    function getSystemConfig() {
      return get(/databases/$(database)/documents/system/config).data;
    }

    function isSystemOwner() {
      return isSignedIn() &&
        hasSystemConfig() &&
        getSystemConfig().ownerUid == request.auth.uid &&
        hasAdminDoc(request.auth.uid) &&
        getAdminDoc(request.auth.uid).role == 'OWNER' &&
        getAdminDoc(request.auth.uid).uid == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        isSystemOwner() ||
        (hasAdminDoc(request.auth.uid) && getAdminDoc(request.auth.uid).role in ['ADMIN', 'OWNER'])
      );
    }

    function hasApprovedProfile(profileType) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid + '_' + profileType)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid + '_' + profileType)).data.status == 'APROVADO';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    match /system/{docId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if isSystemOwner() &&
        docId == 'config' &&
        incoming().keys().hasAll(['ownerUid', 'ownerEmail', 'initializedAt', 'systemVersion']);
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSystemOwner() &&
        isValidId(adminId) &&
        incoming().uid == adminId &&
        incoming().role in ['ADMIN', 'OWNER'];
      allow update: if isSystemOwner() &&
        incoming().uid == existing().uid &&
        incoming().role in ['ADMIN', 'OWNER'];
      allow delete: if isSystemOwner() && adminId != request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().name is string &&
        incoming().name.size() >= 2 &&
        incoming().name.size() <= 120 &&
        incoming().email is string &&
        incoming().email.size() <= 120 &&
        incoming().accountStatus in ['ACTIVE', 'BLOCKED'] &&
        incoming().keys().hasAll(['uid', 'name', 'email', 'createdAt', 'accountStatus']) &&
        incoming().keys().hasOnly(['uid', 'name', 'email', 'phone', 'createdAt', 'accountStatus']);

      allow update: if (
        isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone'])
      ) || isAdmin();

      allow delete: if isSystemOwner();
    }

    match /profiles/{profileId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'PENDENTE' &&
        incoming().profileType in ['DONOR', 'RECEIVER', 'TRANSPORTER'] &&
        incoming().userName is string &&
        incoming().userName.size() <= 120 &&
        incoming().userEmail is string &&
        incoming().userEmail.size() <= 120 &&
        incoming().keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'profileType', 'status', 'requestedAt']) &&
        incoming().keys().hasOnly(['id', 'userId', 'userName', 'userEmail', 'userPhone', 'profileType', 'status', 'requestedAt', 'decidedAt', 'decidedBy', 'decisionNotes']);

      allow update: if isAdmin();

      allow delete: if isSystemOwner();
    }

    match /food_batches/{batchId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        hasApprovedProfile('DONOR') &&
        incoming().donorId == request.auth.uid &&
        incoming().status == 'DISPONIVEL' &&
        incoming().quantity is number &&
        incoming().quantity > 0 &&
        incoming().unit in ['kg', 'g', 'litros', 'unidades'] &&
        incoming().fitForConsumption == true &&
        incoming().foodName is string &&
        incoming().foodName.size() >= 3 &&
        incoming().foodName.size() <= 150 &&
        incoming().keys().hasAll([
          'id', 'donorId', 'donorName', 'foodName', 'category',
          'quantity', 'unit', 'expirationDate', 'storageCondition',
          'pickupAddress', 'pickupWindowStart', 'pickupWindowEnd',
          'fitForConsumption', 'status', 'createdAt'
        ]);

      allow update: if isSignedIn() && (
        (existing().donorId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().status == 'CANCELADO') ||

        (hasApprovedProfile('RECEIVER') &&
         existing().status == 'DISPONIVEL' &&
         incoming().status == 'RESERVADO' &&
         incoming().reservedBy == request.auth.uid) ||

        (hasApprovedProfile('RECEIVER') &&
         existing().reservedBy == request.auth.uid &&
         (incoming().status == 'DISPONIVEL' || incoming().status == 'EXPIRADO')) ||

        isAdmin()
      );

      allow delete: if isSystemOwner();
    }

    match /reservations/{reservationId} {
      allow get: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        hasApprovedProfile('RECEIVER') &&
        incoming().receiverId == request.auth.uid &&
        incoming().status == 'PENDENTE_APROVACAO' &&
        incoming().keys().hasAll([
          'id', 'batchId', 'foodName', 'batchQuantity', 'batchUnit',
          'donorId', 'donorName', 'receiverId', 'receiverName',
          'receiverEmail', 'status', 'requestedAt'
        ]);

      allow update: if isSignedIn() && (
        (existing().receiverId == request.auth.uid &&
         incoming().status == 'CANCELADA' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'canceledAt', 'cancelReason'])) ||

        (isAdmin() &&
         incoming().status in ['APROVADA', 'REJEITADA'] &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'decisionNotes']))
      );

      allow delete: if isSystemOwner();
    }
  }
}
